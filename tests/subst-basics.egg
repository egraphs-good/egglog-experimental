;; Semantics of `unstable-subst`, one case per push/pop scope so the cases do
;; not see each other's unions. Cases that assert something `check` cannot see —
;; e-class identity, table sizes, error variants — stay in `tests/subst.rs`.

(datatype Math
  (Num i64)
  (Var String)
  (Add Math Math)
  (Mul Math Math))
(sort MathToMath (Map Math Math))

;; Every occurrence of a key is replaced.
(push)
(let $x (Var "x"))
(let $y (Var "y"))
(let $e (Add $x (Mul $x (Num 2))))
(let $copy (unstable-subst $e (map-insert (map-empty) $x $y)))
(check (= $copy (Add $y (Mul $y (Num 2)))))
(fail (check (= $copy $e)))
(pop)

;; Substitution is simultaneous, so a swap is a swap rather than two passes.
(push)
(let $x (Var "x"))
(let $y (Var "y"))
(let $e (Add $x $y))
(let $copy (unstable-subst $e (map-insert (map-insert (map-empty) $x $y) $y $x)))
(check (= $copy (Add $y $x)))
(pop)

;; Copying an e-class copies all of its e-nodes, so an equation that holds for
;; every value of the substituted class survives: `x * 0 = 0` stays `5 * 0 = 0`.
(push)
(rewrite (Mul a (Num 0)) (Num 0))
(let $x (Var "x"))
(let $e (Mul $x (Num 0)))
(run 1)
(check (= $e (Num 0)))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Num 5))))
(check (= $copy (Mul (Num 5) (Num 0))))
(check (= $copy (Num 0)))
(pop)

;; The same mechanism is unsound on a *ground* equation, which holds only for
;; the class it pins down: `x + 1 = 5` says `x = 4`, so substituting `x := 9`
;; asserts `9 + 1 = 5`. Only substitute classes that behave like universally
;; quantified variables.
(push)
(let $x (Var "x"))
(let $e (Add $x (Num 1)))
(union $e (Num 5))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Num 9))))
(check (= $copy (Add (Num 9) (Num 1))))
(check (= $copy (Num 5)))
(pop)

;; A key e-class is replaced whole, never walked into, so the other e-nodes in
;; it are not dragged along: with `{Num 1, Var "x"}` in one class and `x |-> 2`,
;; nothing asserts `1 = 2`.
(push)
(let $x (Var "x"))
(let $one (Num 1))
(union $x $one)
(let $e (Add $x (Num 3)))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Num 2))))
(check (= $copy (Add (Num 2) (Num 3))))
(fail (check (= (Num 1) (Num 2))))
(check (= (Num 1) (Var "x")))
(fail (check (= $copy $e)))
(pop)

;; A replacement is spliced into the copy without being walked, so unlike the
;; root it may be a term this same action just built.
(push)
(let $x (Var "x"))
(let $e (Add $x (Num 1)))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Mul (Num 2) (Num 3)))))
(check (= $copy (Add (Mul (Num 2) (Num 3)) (Num 1))))
(pop)

;; E-classes captured in an `unstable-fn` value are substituted too. The sort
;; reports its element sorts as the arguments still to be applied, which for a
;; nullary one is nothing at all, so these are easy to miss.
(push)
(sort Thunk (UnstableFn () Math))
(constructor Delay (Thunk) Math)
(let $x (Var "x"))
(let $e (Delay (unstable-fn "Add" $x (Num 1))))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Num 5))))
(check (= $copy (Delay (unstable-fn "Add" (Num 5) (Num 1)))))
(fail (check (= $copy $e)))
(pop)

;; A cyclic e-class is copied when one of its e-nodes has all its children
;; outside the cycle: that e-node names the copy, and the cyclic one then unions
;; into it. No e-class id is invented.
(push)
(let $x (Var "x"))
(let $loop (Add $x (Num 0)))
(union $loop (Add $loop (Num 0)))
(let $copy (unstable-subst $loop (map-insert (map-empty) $x (Num 7))))
(check (= $copy (Add (Num 7) (Num 0))))
(check (= $copy (Add $copy (Num 0))))
(pop)

;; The root's sort is free: it need not be the map's key sort, because a
;; substitution reaches through every sort in the term structure.
(push)
(datatype MathList (Nil) (Cons Math MathList))
(let $x (Var "x"))
(let $list (Cons $x (Cons (Num 1) (Nil))))
(let $copy (unstable-subst $list (map-insert (map-empty) $x (Num 8))))
(check (= $copy (Cons (Num 8) (Cons (Num 1) (Nil)))))
(pop)

;; E-classes reached only through a container child are substituted, and the
;; container is rebuilt around the replacements.
(push)
(sort MathVec (Vec Math))
(constructor Sum (MathVec) Math)
(let $x (Var "x"))
(let $e (Sum (vec-of $x (Num 1))))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Num 4))))
(check (= $copy (Sum (vec-of (Num 4) (Num 1)))))
(pop)

;; A container with no e-classes inside is left alone.
(push)
(sort Ints (Vec i64))
(constructor Tagged (Math Ints) Math)
(let $x (Var "x"))
(let $e (Tagged $x (vec-of 1 2)))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Num 5))))
(check (= $copy (Tagged (Num 5) (vec-of 1 2))))
(pop)

;; A replacement that is itself affected is copied where it occurs on its own:
;; `x |-> y` with `y = x + 1` gives `Mul y (Add y 1)`.
(push)
(let $x (Var "x"))
(let $y (Add $x (Num 1)))
(let $e (Mul $x $y))
(let $copy (unstable-subst $e (map-insert (map-empty) $x $y)))
(check (= $copy (Mul $y (Add $y (Num 1)))))
(pop)

;; The primitive runs in a `:naive` rule head, which is what makes rule-driven
;; substitution possible at all.
(push)
(constructor Beta (Math Math Math) Math)
(rule ((= lhs (Beta body from to)))
      ((union lhs (unstable-subst body (map-insert (map-empty) from to))))
      :naive)
(let $x (Var "x"))
(let $b (Beta (Add $x $x) $x (Num 3)))
(run 1)
(check (= $b (Add (Num 3) (Num 3))))
(pop)

;; A constructor declared inside a `push` is gone after the `pop`, and the walk
;; does not try to read its table.
(push)
(let $x (Var "x"))
(push)
(constructor Neg (Math) Math)
(let $inner (Neg $x))
(pop)
(let $e (Add $x (Num 1)))
(let $copy (unstable-subst $e (map-insert (map-empty) $x (Num 2))))
(check (= $copy (Add (Num 2) (Num 1))))
(pop)
