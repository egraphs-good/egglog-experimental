; Minimized from the exported eggcc 2mm pass1 helper surface.
; The full export also contains pair-first query facts that PR #927's current
; proof encoder rejects before execution.

(datatype Expr
  (Value i64)
  (Flag bool)
  (Add Expr Expr)
  (If Expr Expr Expr))

(datatype Term
  (NoTerm)
  (TermConst i64)
  (TermAdd Term Term)
  (TermIf Term Term Term))

(sort TermAndCost (Pair Term i64))
(function ExtractedExpr (Expr) TermAndCost :merge (pair-min-by-second-i64 old new))

(sort IntOrBool (Either i64 bool))
(sort Bound (Maybe IntOrBool))
(function lo-bound (Expr) Bound :merge (maybe-either-i64-bool-max old new))
(function hi-bound (Expr) Bound :merge (maybe-either-i64-bool-min old new))

(ruleset terms)
(ruleset interval-analysis)
(ruleset interval-rewrite)

(rule ((= expr (Value x)))
      ((set (ExtractedExpr expr) (pair (TermConst x) 1))
       (set (lo-bound expr) (maybe-some (either-left x)))
       (set (hi-bound expr) (maybe-some (either-left x))))
      :ruleset terms)

(rule ((= expr (Add a b))
       (= lo-a (either-unwrap-left (maybe-unwrap (lo-bound a))))
       (= lo-b (either-unwrap-left (maybe-unwrap (lo-bound b)))))
      ((set (lo-bound expr) (maybe-some (either-left (+ lo-a lo-b)))))
      :ruleset interval-analysis)

(rule ((= expr (Add a b))
       (= hi-a (either-unwrap-left (maybe-unwrap (hi-bound a))))
       (= hi-b (either-unwrap-left (maybe-unwrap (hi-bound b)))))
      ((set (hi-bound expr) (maybe-some (either-left (+ hi-a hi-b)))))
      :ruleset interval-analysis)

(rule ((= expr (Flag x)))
      ((set (lo-bound expr) (maybe-some (either-right x)))
       (set (hi-bound expr) (maybe-some (either-right x))))
      :ruleset interval-analysis)

(rule ((= expr (If cond thn els))
       (= true (either-unwrap-right (maybe-unwrap (lo-bound cond)))))
      ((union expr thn))
      :ruleset interval-rewrite)

(rule ((= expr (If cond thn els))
       (= lo-thn (lo-bound thn))
       (= lo-els (lo-bound els)))
      ((set (lo-bound expr) (maybe-either-i64-bool-min lo-thn lo-els)))
      :ruleset interval-analysis)

(rule ((= expr (If cond thn els))
       (= hi-thn (hi-bound thn))
       (= hi-els (hi-bound els)))
      ((set (hi-bound expr) (maybe-either-i64-bool-max hi-thn hi-els)))
      :ruleset interval-analysis)

(rule ((= lo (either-unwrap-left (maybe-unwrap (lo-bound expr))))
       (= hi (either-unwrap-left (maybe-unwrap (hi-bound expr))))
       (> lo hi))
      ((set (lo-bound expr) (maybe-none))
       (set (hi-bound expr) (maybe-none)))
      :ruleset interval-analysis)

(let a (Value 2))
(let b (Value 5))
(let sum (Add a b))
(let cond (Flag true))
(let if-expr (If cond a b))

(set (ExtractedExpr sum) (pair (NoTerm) 100))
(set (ExtractedExpr sum) (pair (TermAdd (TermConst 2) (TermConst 5)) 3))

(run-schedule
  (seq
    (repeat 2 (run terms))
    (repeat 8 (run interval-analysis))
    (repeat 2 (run interval-rewrite))))

(check (lo-bound a) (maybe-some (either-left 2)))
(check (hi-bound b) (maybe-some (either-left 5)))
(check (lo-bound sum) (maybe-some (either-left 7)))
(check (hi-bound sum) (maybe-some (either-left 7)))
(check (lo-bound if-expr) (maybe-some (either-left 2)))
(check (hi-bound if-expr) (maybe-some (either-left 5)))
