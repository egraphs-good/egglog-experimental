;; Roots must be effectful; a pure root is a plain tree extraction, which
;; `extract` already provides.
(datatype Expr (Arg) (Num i64) (Print Expr Expr))
(relation Effectful (Expr))
(rule ((= e (Arg))) ((Effectful e)))
(rule ((= e (Print v s))) ((Effectful e)))
(let $n (Num 1))
(run 1)
(effsafe-extract Effectful $n)
